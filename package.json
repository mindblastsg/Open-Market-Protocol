{
  "name": "open-market-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Reference implementation workspace for Open Market Protocol",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint . --deny-warnings",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "db:migrate": "npm run db:migrate --workspace @omp/api",
    "dev:api": "npm run dev --workspace @omp/api",
    "dev:web": "npm run dev --workspace @omp/web"
  },
  "devDependencies": {
    "oxlint": "^1.93.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}


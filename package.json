{
  "name": "open-market-protocol",
  "version": "0.0.0",
  "private": true,
  "description": "Reference implementation workspace for Open Market Protocol",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:api": "npm run dev --workspace @omp/api",
    "dev:web": "npm run dev --workspace @omp/web"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}

